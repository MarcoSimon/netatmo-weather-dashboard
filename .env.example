# Credentials of your app at https://dev.netatmo.com/apps (README, "Setting
# it up"). Copy this file to .env and fill it in.
# These stay needed after the initial token pair: every renewal is signed
# with them.
NETATMO_CLIENT_ID=
NETATMO_CLIENT_SECRET=

# Where the poller keeps its state. Both are gitignored.
# token.json is created by hand once, from the portal's token generator.
TOKEN_FILE=./token.json
DATABASE_FILE=./data/weather.sqlite

# Where the HTTP server listens. 0.0.0.0 makes it reachable from the tablet on
# the LAN; the server needs no Netatmo credentials and never reads TOKEN_FILE.
SERVER_HOST=0.0.0.0
SERVER_PORT=8080

# Poll interval in milliseconds. The station uploads no faster than this (two
# five-minute points every ten minutes), so only lower it to shorten a test run.
POLL_INTERVAL_MS=600000

# How far before the access token expires to renew it. Leave unset for the
# 5-minute default. A very large value forces a refresh every cycle, which is
# how the rotation is stress-tested without waiting two days.
# TOKEN_SKEW_MS=999999999

# Coordinates for the Open-Meteo forecast (decimal degrees).
FORECAST_LAT=
FORECAST_LON=

# The house's time zone and habits. Leave any of these unset for the default
# shown. The tablet computes evening and night in its own zone, so TIME_ZONE
# must match it; unset, it is the zone of the machine running the server.
# TIME_ZONE=Europe/Berlin
# The evening starts this many minutes after sunset; negative is before it,
# for a room that gets dark before the sky does.
# EVENING_SUNSET_OFFSET_MIN=-15
# When the evening starts without a forecast, in summer and in winter time.
# EVENING_FALLBACK_SUMMER=20:30
# EVENING_FALLBACK_WINTER=17:00
# The night rendering, from bedtime until getting up. Set the kiosk browser's
# screen schedule to the same two times.
# NIGHT_FROM=22:00
# DAY_FROM=06:00

# Charge cycling (docs/tablet-setup.md §4): the Shelly plug the wall tablet
# charges from, and the kiosk browser's Remote Administration on that tablet.
# Only `npm run charge:deploy` and `npm run charge:log` read these; the deploy
# puts the kiosk browser's address and password on the plug. Quote a value
# that contains `#`: unquoted, Node reads it as the start of a comment and
# cuts the value there, while a shell sourcing the same file does not.
# SHELLY_HOST=
# SHELLY_PASSWORD=''
# FULLY_HOST=
# FULLY_PASSWORD=''
